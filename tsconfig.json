{
  // Base config used by the editor, type checking, ESLint and the tests (via ts-node).
  // The published build uses tsconfig.build.json.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node20",
    "moduleResolution": "Node16",
    "types": ["node", "mocha"],
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // typeconfig relies on property decorators, which break with [[Define]] class field semantics
    "useDefineForClassFields": false,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
